{
    "name": "cs2",
    "env_var": "HL2SDKCS2",
    "extension": "2.cs2",
    "code": 25,
    "define": "CS2",
    "platforms": {
        "windows": [
            "x86_64"
        ],
        "linux": [
            "x86_64"
        ]
